{
  "name": "deepseek-harness-sessions",
  "displayName": "DeepSeek Harness Sessions",
  "description": "Unofficial: run DeepSeek Harness (dsh) as a native agent session in VS Code, alongside Claude Code and Codex.",
  "version": "0.0.4",
  "publisher": "kalynnka",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalynnka/vscode-deepseek-harness.git"
  },
  "engines": {
    "vscode": "^1.133.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "agent",
    "chat session"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantAdditions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "deepseek-whale": {
        "description": "The dsh whale",
        "default": {
          "fontPath": "media/dsh-icons.ttf",
          "fontCharacter": "\\E001"
        }
      },
      "deepseek-perm-read": {
        "description": "dsh read-only preset (shield + check)",
        "default": {
          "fontPath": "media/dsh-icons.ttf",
          "fontCharacter": "\\E002"
        }
      },
      "deepseek-perm-write": {
        "description": "dsh workspace-write preset (shield + pencil)",
        "default": {
          "fontPath": "media/dsh-icons.ttf",
          "fontCharacter": "\\E003"
        }
      },
      "deepseek-perm-full": {
        "description": "dsh full-access preset (shield + exclamation)",
        "default": {
          "fontPath": "media/dsh-icons.ttf",
          "fontCharacter": "\\E004"
        }
      }
    },
    "chatSessions": [
      {
        "type": "deepseek-harness",
        "name": "deepseek-harness",
        "displayName": "DeepSeek",
        "inputPlaceholder": "Chat with DeepSeek Harness",
        "description": "Sessions run by your own dsh install",
        "canDelegate": true,
        "icon": "deepseek-whale",
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsImageAttachments": true
        },
        "commands": [
          {
            "name": "plan",
            "description": "Plan mode",
            "when": "deepseekHarness.command.plan"
          },
          {
            "name": "compact",
            "description": "Compact the conversation context",
            "when": "deepseekHarness.command.compact"
          },
          {
            "name": "permission",
            "description": "Switch the permission preset",
            "when": "deepseekHarness.command.permission"
          },
          {
            "name": "goal",
            "description": "Session goals",
            "when": "deepseekHarness.command.goal"
          },
          {
            "name": "export",
            "description": "Export the session",
            "when": "deepseekHarness.command.export"
          },
          {
            "name": "feedback",
            "description": "File feedback",
            "when": "deepseekHarness.command.feedback"
          },
          {
            "name": "models",
            "description": "Switch the model — every provider your dsh advertises"
          }
        ]
      }
    ],
    "configuration": {
      "title": "DeepSeek Harness Sessions",
      "properties": {
        "deepseekHarness.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to your `dsh` executable. Empty resolves it from `PATH`, then from `#deepseekHarness.checkoutPath#`. This extension never ships a dsh of its own.",
          "scope": "machine"
        },
        "deepseekHarness.checkoutPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a built deepseek-harness checkout, used when `dsh` is not on `PATH`. Its `apps/cli/lib/bin.js` is run with `node`.",
          "scope": "machine"
        },
        "deepseekHarness.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "Overrides `$DSH_HOME`. Empty uses your real dsh home, so the editor sees the profiles, settings, credentials and history you already have.",
          "scope": "machine"
        },
        "deepseekHarness.historyPageMessages": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "markdownDescription": "How many messages each `session.history` call asks for. **This is not a limit on what is restored:** a reopened session is always read back to the first event of its log, however long it is — this only sets how much of it one call carries. dsh counts messages backwards from where the call starts and returns the whole contiguous range behind them, tool calls, results and token-level chunk events included, so lowering this makes each call smaller and a long session take more of them. `50` is dsh's own default.",
          "scope": "window"
        },
        "deepseekHarness.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments appended to `dsh web`. The bind host and port are not configurable: the server has no auth, so it is always loopback on an ephemeral port.",
          "scope": "machine"
        }
      }
    },
    "commands": [
      {
        "command": "deepseekHarness.showLog",
        "title": "DeepSeek Harness: Show Log"
      },
      {
        "command": "deepseekHarness.restart",
        "title": "DeepSeek Harness: Restart Harness Process"
      },
      {
        "command": "deepseekHarness.slashCommand.run",
        "title": "DeepSeek Harness: Run Slash Command…"
      },
      {
        "command": "deepseekHarness.pickModel",
        "title": "DeepSeek Harness: Switch Model…"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npx --yes @vscode/vsce package",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out/smoke.cjs --log-level=warning && node out/smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
